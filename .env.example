# Copy to .env with make env; a random secret is generated automatically.
HOMEIO_VERSION=dev
HOMEIO_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# SQLite file and backup directory; keep both inside persistent mounted storage.
# Local/Compose: data/...; Coolify: /data/...
HOMEIO_DATABASE=data/homeio.sqlite3
HOMEIO_BACKUP=data/backups
HOMEIO_HOST=127.0.0.1
HOMEIO_PORT=8000
HOMEIO_ALLOWED_HOSTS=localhost,127.0.0.1
HOMEIO_COOKIE_SECURE=false
HOMEIO_SESSION_HOURS=8
# Enable only behind an HTTPS reverse proxy before exposing the app publicly.
HOMEIO_HTTPS=false

# Host user/group for the shared data directory; make env sets these automatically.
HOMEIO_UID=1000
HOMEIO_GID=1000
